// Programa: Cuenta regresiva de 15 a 0 y se mantiene en 0
// Dirección 0
000001100001111 // MOV B, 15
// Dirección 1
100111100000000 // CMP B, 0
// Dirección 2
101010000000101 // JZ 5
// Dirección 3
000101100000001 // SUB B, 1
// Dirección 4
101001100000001 // JMP 1
// Dirección 5
101001100000101 // JMP 5
